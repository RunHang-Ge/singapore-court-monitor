# Token is entered in Render Environment. Never commit the real value.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=activeSG_monitor_bot
TELEGRAM_MODE=webhook
# Render supplies RENDER_EXTERNAL_URL automatically; local deployments may use PUBLIC_URL.
PUBLIC_URL=https://singapore-court-monitor.onrender.com
# Set either the private Telegram user ID, or a long random one-time binding code.
TELEGRAM_USER_ID=
TELEGRAM_CHAT_ID=
BINDING_CODE=
# Admin page uses HTTP Basic: username admin, password below (16+ characters).
ADMIN_PASSWORD=
# Render paid disk mounted at /var/data. Use ./data for local development.
DATA_DIR=./data
BROWSER_HEADLESS=true
# Optional: external browser CDP URL if native Chromium cannot run on the host.
BROWSER_CDP_URL=